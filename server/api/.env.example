# FreedomVPN server API deployment configuration
# Copy to .env for a deployment and replace every value with real credentials.

ADMIN_TOKEN=replace-with-a-long-random-admin-token
WG_IFACE=wg0
SERVER_PUBLIC_KEY=replace-with-wireguard-server-public-key
SERVER_ENDPOINT=vpn.example.com:51820

PORT=3000
VPN_SUBNET=10.8.0.0/24
PEER_EXPIRY_DAYS=30
DNS1=1.1.1.1
DNS2=1.0.0.1
SERVER_ID=primary
SERVER_NAME=FreedomVPN Primary
SERVER_COUNTRY=Deployment-specific
SERVER_COUNTRY_CODE=XX
SERVER_CITY=Deployment-specific

# Optional JSON list of additional gateways.
# EXTRA_SERVERS_JSON=[]

# Private Prometheus scrape token. Leave unset to disable /api/metrics.
METRICS_TOKEN=replace-with-a-long-random-metrics-token
